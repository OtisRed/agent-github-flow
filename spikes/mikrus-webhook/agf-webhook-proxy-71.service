[Unit]
Description=Isolated reverse proxy for Agent GitHub Flow spike
After=agf-webhook-spike-71.service
Requires=agf-webhook-spike-71.service

[Service]
Type=simple
DynamicUser=yes
RuntimeDirectory=agf-webhook-proxy-71
StateDirectory=agf-webhook-proxy-71
StateDirectoryMode=0700
ExecStart=/usr/sbin/nginx -c /opt/agent-github-flow-spike-71/standalone-nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -c /opt/agent-github-flow-spike-71/standalone-nginx.conf -s reload
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET
MemoryMax=64M
TasksMax=16
